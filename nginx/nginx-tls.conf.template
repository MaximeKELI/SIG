# Généré côté serveur via scripts/prepare-production.sh (ne pas éditer à la main).
# Source : nginx/nginx-tls.conf.template → nginx/nginx-tls.conf

worker_processes auto;
events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    client_max_body_size 50M;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server_tokens off;

    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=300r/m;
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=15r/m;

    server {
        listen 80;
        server_name __DOMAIN__ __DOMAIN_WWW__;

        location /.well-known/acme-challenge/ {
            root /usr/share/nginx/html/frontend;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl http2;
        server_name __DOMAIN__ __DOMAIN_WWW__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy same-origin always;
        add_header Permissions-Policy "geolocation=(self), camera=(self), microphone=()" always;

        set $django_host web;

        location /static/ {
            alias /usr/share/nginx/static/;
            expires 7d;
            add_header Cache-Control "public";
        }
        location /media/  {
            alias /usr/share/nginx/media/;
            autoindex off;
            limit_except GET HEAD { deny all; }
        }
        location = /privacy.html {
            root /usr/share/nginx/html/frontend;
            add_header Cache-Control "public, max-age=3600";
        }
        location = /sw.js {
            root /usr/share/nginx/html/frontend;
            add_header Cache-Control "no-cache";
            add_header Service-Worker-Allowed "/";
        }
        location = /manifest.json {
            root /usr/share/nginx/html/frontend;
            add_header Cache-Control "no-cache";
        }
        location / {
            root /usr/share/nginx/html/frontend;
            try_files $uri $uri/ /index.html;
        }

        location /ws/ {
            proxy_pass http://$django_host:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 3600s;
        }

        location ~ ^/api/v1/auth/(login|register|token)/ {
            limit_req zone=auth_limit burst=5 nodelay;
            proxy_pass http://$django_host:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/ {
            limit_req zone=api_limit burst=50 nodelay;
            proxy_pass http://$django_host:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 120s;
        }

        location /admin/ {
            proxy_pass http://$django_host:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /health/ {
            proxy_pass http://$django_host:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
