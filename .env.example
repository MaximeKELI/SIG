# SIG-SOLS-TOGO-2026-01 — copy to .env
DEBUG=1
SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,web,django,nginx

POSTGRES_DB=sig_sols
POSTGRES_USER=sig_sols
POSTGRES_PASSWORD=sig_sols_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Base temporaire locale (GeoDjango via SpatiaLite)
# DB_BACKEND=sqlite3
# SQLITE_NAME=/app/db.sqlite3
# SPATIALITE_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/mod_spatialite.so

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Production — secrets (ne jamais committer .env)
# SECRET_KEY=<openssl rand -hex 32>
# DEBUG=0
# ALLOWED_HOSTS=sig.example.tg
# CSRF_TRUSTED_ORIGINS=https://sig.example.tg

# Rate limiting (DRF)
THROTTLE_RATE=100/min
THROTTLE_ANON=200/min
THROTTLE_USER=1000/min
THROTTLE_AUTH=20/min
MIDDLEWARE_RATE_PER_MIN=300

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8081,http://localhost:8090

# NASA Earthdata (https://urs.earthdata.nasa.gov/)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
# Token JWT Earthdata Login (alternative au mot de passe, expire ~3 mois)
NASA_EARTHDATA_TOKEN=

# Sentinel Hub — https://apps.sentinel-hub.com/ (OAuth client)
# Ne jamais committer les vraies clés : copier dans .env uniquement.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
# Références compte (partage — pas pour OAuth)
# SENTINEL_HUB_USER_ID=
# SENTINEL_HUB_ACCOUNT_ID=
# Alias accepté pour le secret :
# SENTINEL_HUB_API_KEY=
# SENTINEL_HUB_TOKEN_URL=https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token

# OpenWeather — https://openweathermap.org/api
OPENWEATHER_API_KEY=
# OPENWEATHER_CACHE_SECONDS=600

# Rate limiting
THROTTLE_RATE=100/min

# Site
SITE_NAME=SIG Sols Togo
DEFAULT_REGION=maritime

# Email (production — mot de passe oublié)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@sig-sols.tg

# Google Gemini — assistant IA (chatbot sols / parcelles / quiz)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
THROTTLE_ASSISTANT=30/min

# --- Non intégrés dans le code (voir docs/API_EXTERNES.md) ---
# OPENAI_API_KEY=
# MAPBOX_ACCESS_TOKEN=
