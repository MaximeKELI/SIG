# Copier vers .env sur le serveur de production (ne jamais committer).
# openssl rand -hex 32  →  SECRET_KEY

DEBUG=0
SECRET_KEY=REMPLACER_PAR_OPENSSL_RAND_HEX_32
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

ALLOWED_HOSTS=sig.votredomaine.tg,www.sig.votredomaine.tg
CSRF_TRUSTED_ORIGINS=https://sig.votredomaine.tg,https://www.sig.votredomaine.tg
CORS_ALLOWED_ORIGINS=https://sig.votredomaine.tg,https://www.sig.votredomaine.tg

POSTGRES_DB=sig_sols
POSTGRES_USER=sig_sols
POSTGRES_PASSWORD=REMPLACER_MOT_DE_PASSE_FORT
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_PASSWORD=REMPLACER_MOT_DE_PASSE_REDIS
REDIS_URL=redis://:REMPLACER_MOT_DE_PASSE_REDIS@redis:6379/0
REDIS_CACHE_URL=redis://:REMPLACER_MOT_DE_PASSE_REDIS@redis:6379/1
REDIS_CHANNELS_URL=redis://:REMPLACER_MOT_DE_PASSE_REDIS@redis:6379/2
CELERY_BROKER_URL=redis://:REMPLACER_MOT_DE_PASSE_REDIS@redis:6379/0

SEED_DEMO_DATA=0

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.votredomaine.tg
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sig.votredomaine.tg

NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

SITE_NAME=SIG Sols Togo
DEFAULT_REGION=maritime
